{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doczbs.github.io/Awesome-Academic-Figures/project-schema.json",
  "title": "AAF Portable Projects v1",
  "type": "object",
  "required": ["version", "projects"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "figureIds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "description": { "type": "string", "maxLength": 2000 },
          "figureIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    }
  }
}
